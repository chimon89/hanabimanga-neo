<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.ComicReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="20,10"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        MinHeight="34"
                        Padding="10,6"
                        Click="PreviousChapterButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            <TextBlock Text="上一话" />
                        </StackPanel>
                    </Button>
                    <Button
                        MinHeight="34"
                        Padding="10,6"
                        Click="NextChapterButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="下一话" />
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        Text="{x:Bind ViewModel.ChapterTitle, Mode=OneWay}"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ComicTitle, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ToggleButton
                        x:Name="UpscaledToggleButton"
                        MinHeight="34"
                        Padding="10,6"
                        IsChecked="{x:Bind ViewModel.IsUpscaledLoaded, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanToggleUpscaled, Mode=OneWay}"
                        Click="UpscaledToggleButton_Click"
                        Visibility="{x:Bind ViewModel.HasUpscaledAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                        ToolTipService.ToolTip="AI 超分(高清)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE945;" FontSize="12" />
                            <TextBlock Text="AI 超分" />
                        </StackPanel>
                    </ToggleButton>
                    <TextBlock
                        Text="{x:Bind ViewModel.UpscaledQuotaText, Mode=OneWay}"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.ShowUpscaledQuota, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <Button
                        MinHeight="34"
                        Padding="10,6"
                        Click="PreviousPageButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanGoPreviousPage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsPageMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            <TextBlock Text="上一页" />
                        </StackPanel>
                    </Button>
                    <Button
                        MinHeight="34"
                        Padding="10,6"
                        Click="NextPageButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanGoNextPage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsPageMode, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="下一页" />
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <DropDownButton
                        MinHeight="34"
                        Padding="10,6"
                        ToolTipService.ToolTip="切换视图模式">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.ViewModeLabel, Mode=OneWay}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="翻页模式" Click="PageModeMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE89A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="瀑布流模式" Click="WaterfallModeMenuItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8FD;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        Width="36"
                        Height="34"
                        Padding="0"
                        Click="ScrollTopButton_Click"
                        ToolTipService.ToolTip="回到顶部">
                        <FontIcon Glyph="&#xE74A;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer
                x:Name="ReaderScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Disabled">
                <StackPanel
                    Padding="20,18,20,28"
                    Spacing="12"
                    HorizontalAlignment="Center">

                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <InfoBar
                        IsClosable="False"
                        Severity="Error"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Title="章节加载失败"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                    <InfoBar
                        IsClosable="False"
                        Severity="Warning"
                        IsOpen="{x:Bind ViewModel.UsesWebFallback, Mode=OneWay}"
                        Title="当前为 Web 降级资源"
                        Message="未配置客户端签名密钥时,接口可能返回混淆图片。配置 Reader:AppClientVerifySecret 和 Reader:ClientFingerprint 后可请求原始资源。" />

                    <!--  翻页模式:仅显示当前页  -->
                    <Grid
                        MaxWidth="980"
                        MinWidth="360"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.ShowPageContent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Image
                            Source="{x:Bind ViewModel.CurrentPageUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            ImageOpened="ReaderImage_ImageOpened"
                            ImageFailed="ReaderImage_ImageFailed" />
                    </Grid>

                    <!--  瀑布流模式:本话所有页面纵向排列,ItemsRepeater 虚拟化实现懒加载  -->
                    <ItemsRepeater
                        ItemsSource="{x:Bind ViewModel.Pages}"
                        Visibility="{x:Bind ViewModel.ShowWaterfallContent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:ReaderPageImage">
                                <Grid
                                    MaxWidth="980"
                                    MinWidth="360"
                                    MinHeight="640"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Image
                                        Source="{x:Bind Url, Converter={StaticResource StringToImageSource}}"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        ImageOpened="ReaderImage_ImageOpened"
                                        ImageFailed="ReaderImage_ImageFailed" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
