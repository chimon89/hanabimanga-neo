<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.ComicReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="20,10"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        MinHeight="34"
                        Padding="10,6"
                        Click="PreviousChapterButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            <TextBlock Text="上一话" />
                        </StackPanel>
                    </Button>
                    <Button
                        MinHeight="34"
                        Padding="10,6"
                        Click="NextChapterButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="下一话" />
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        Text="{x:Bind ViewModel.ChapterTitle, Mode=OneWay}"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ComicTitle, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        MinHeight="34"
                        Padding="10,6"
                        Click="PreviousPageButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanGoPreviousPage, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            <TextBlock Text="上一页" />
                        </StackPanel>
                    </Button>
                    <Button
                        MinHeight="34"
                        Padding="10,6"
                        Click="NextPageButton_Click"
                        IsEnabled="{x:Bind ViewModel.CanGoNextPage, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="下一页" />
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="36"
                        Height="34"
                        Padding="0"
                        Click="ScrollTopButton_Click"
                        ToolTipService.ToolTip="回到顶部">
                        <FontIcon Glyph="&#xE74A;" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer
                x:Name="ReaderScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                ZoomMode="Disabled"
                ViewChanged="ReaderScrollViewer_ViewChanged">
                <StackPanel
                    Padding="20,18,20,28"
                    Spacing="12"
                    HorizontalAlignment="Center">

                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <InfoBar
                        IsClosable="False"
                        Severity="Error"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Title="章节加载失败"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                    <InfoBar
                        IsClosable="False"
                        Severity="Warning"
                        IsOpen="{x:Bind ViewModel.UsesWebFallback, Mode=OneWay}"
                        Title="当前为 Web 降级资源"
                        Message="未配置客户端签名密钥时,接口可能返回混淆图片。配置 Reader:AppClientVerifySecret 和 Reader:ClientFingerprint 后可请求原始资源。" />

                    <Grid
                        MaxWidth="980"
                        MinWidth="360"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.HasReader, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Image
                            Source="{x:Bind ViewModel.CurrentPageUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                            Stretch="Uniform"
                            HorizontalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
