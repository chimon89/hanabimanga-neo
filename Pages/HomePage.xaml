<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:hanabimanga.Pages"
    xmlns:models="using:hanabimanga.Models"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer
            Grid.Row="1"
            Padding="0,0,0,24"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1180"
                HorizontalAlignment="Center"
                Spacing="20">
                <ProgressRing
                    Margin="20,0,20,0"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <InfoBar
                    Margin="20,0,20,0"
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Title="加载失败"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                <Grid
                    Margin="20,0,20,0"
                    HorizontalAlignment="Stretch"
                    Height="220"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="RecommendedPanel"
                        Grid.Column="0"
                        Padding="14"
                        CornerRadius="8"
                        VerticalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.HasRecommendations, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock
                                    Text="为你推荐"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <Button
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="8,4"
                                    MinHeight="28"
                                    Click="ShuffleRecommendations_Click"
                                    Visibility="{x:Bind ViewModel.CanShuffleRecommendations, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                        <TextBlock Text="换一换" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsRepeater
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.RecommendedItems, Mode=OneWay}"
                                Margin="0,10,0,0">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsJustification="Start"
                                        ItemsStretch="Fill"
                                        MinColumnSpacing="10"
                                        MinRowSpacing="8"
                                        MinItemWidth="200"
                                        MinItemHeight="68" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:HomeFeedItem">
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            Height="68"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Click="ComicItem_Click"
                                            Tag="{x:Bind Id}"
                                            ToolTipService.ToolTip="{x:Bind Title}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="50"
                                                    Height="66"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                    <Image
                                                        Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSource}}"
                                                        Stretch="UniformToFill" />
                                                </Border>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="10,2,4,0"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">
                                                    <TextBlock
                                                        Text="{x:Bind Title}"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        MaxLines="1"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Text="{x:Bind Author}"
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        MaxLines="1"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </Border>

                    <Grid
                        x:Name="BannerContainer"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.HasBanners, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FlipView
                            x:Name="BannerFlipView"
                            ItemsSource="{x:Bind ViewModel.Banners, Mode=OneWay}"
                            CornerRadius="8">
                            <FlipView.ItemTemplate>
                                <DataTemplate x:DataType="models:HomeFeedBanner">
                                    <Grid>
                                        <Image
                                            Source="{x:Bind ImageUrl, Converter={StaticResource StringToImageSource}}"
                                            Stretch="UniformToFill" />
                                        <Border
                                            VerticalAlignment="Bottom"
                                            Padding="16,8"
                                            Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}">
                                            <TextBlock
                                                Text="{x:Bind Title}"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </FlipView.ItemTemplate>
                        </FlipView>
                        <PipsPager
                            x:Name="BannerPipsPager"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8"
                            NumberOfPages="{x:Bind ViewModel.Banners.Count, Mode=OneWay}"
                            SelectedPageIndex="{Binding ElementName=BannerFlipView, Path=SelectedIndex, Mode=TwoWay}" />
                    </Grid>
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="20" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:HomeFeedSection">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="{x:Bind Title}"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Margin="20,0,20,10" />

                                <ItemsRepeater
                                    ItemsSource="{x:Bind Items}"
                                    Margin="20,0,20,0"
                                    HorizontalAlignment="Stretch">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsJustification="Start"
                                            ItemsStretch="Fill"
                                            MinColumnSpacing="12"
                                            MinRowSpacing="14"
                                            MinItemWidth="184"
                                            MinItemHeight="320" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:HomeFeedItem">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                Padding="10"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="10"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Click="ComicItem_Click"
                                                Tag="{x:Bind Id}"
                                                ToolTipService.ToolTip="{x:Bind Title}">
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="226" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Border
                                                        Grid.Row="0"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                        <Image
                                                            Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSource}}"
                                                            Stretch="UniformToFill" />
                                                    </Border>

                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Text="{x:Bind Title}"
                                                        FontWeight="SemiBold"
                                                        LineHeight="20"
                                                        Height="40"
                                                        Margin="2,8,2,0"
                                                        MaxLines="2"
                                                        TextWrapping="Wrap"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Top" />

                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Text="{x:Bind Author}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Margin="2,4,2,0"
                                                        MaxLines="1"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Top" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
