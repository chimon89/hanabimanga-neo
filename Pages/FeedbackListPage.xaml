<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.FeedbackListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="FeedbackVoteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="FeedbackScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Width="{Binding ElementName=FeedbackScrollViewer, Path=ViewportWidth}"
                MinHeight="{Binding ElementName=FeedbackScrollViewer, Path=ViewportHeight}"
                MaxWidth="920"
                Padding="32,18,32,96"
                HorizontalAlignment="Center"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Width="38"
                        Height="38"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>

                    <StackPanel
                        Grid.Column="1"
                        MinWidth="0"
                        Spacing="3">
                        <TextBlock
                            Text="资源与反馈"
                            FontSize="28"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="浏览社区反馈,与你关心的工单产生共鸣"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="8">
                    <StackPanel
                        x:Name="DomainChips"
                        Orientation="Horizontal"
                        Spacing="8" />
                    <StackPanel
                        x:Name="StatusChips"
                        Orientation="Horizontal"
                        Spacing="8" />
                    <StackPanel
                        x:Name="SortChips"
                        Orientation="Horizontal"
                        Spacing="8" />
                </StackPanel>

                <ProgressRing
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <InfoBar
                    Grid.Row="3"
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Title="加载失败"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <Grid Grid.Row="4">
                    <ItemsRepeater
                        ItemsSource="{x:Bind ViewModel.Tickets, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasTickets, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:FeedbackTicket">
                                <Border
                                    Padding="16"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Tag="{x:Bind}"
                                    Tapped="TicketCard_Tapped"
                                    ToolTipService.ToolTip="查看反馈详情">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Width="36"
                                                Height="36"
                                                CornerRadius="18"
                                                Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                                <Image
                                                    Source="{x:Bind AvatarPreviewUrl, Converter={StaticResource StringToImageSource}}"
                                                    Stretch="UniformToFill" />
                                            </Border>

                                            <StackPanel
                                                Grid.Column="1"
                                                MinWidth="0"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    Text="{x:Bind ReporterName}"
                                                    FontWeight="SemiBold"
                                                    MaxLines="1"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind CreatedAtText}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <Border
                                                Grid.Column="2"
                                                Padding="9,3"
                                                VerticalAlignment="Center"
                                                CornerRadius="6"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                <TextBlock
                                                    Text="{x:Bind StatusText}"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock
                                            Text="{x:Bind Title}"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            TextWrapping="WrapWholeWords"
                                            MaxLines="2"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Text="{x:Bind Description}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            LineHeight="20"
                                            MaxLines="2"
                                            TextWrapping="WrapWholeWords"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock
                                            Text="{x:Bind RelationText}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasRelation, Converter={StaticResource BoolToVisibility}}" />

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Padding="8,3"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock
                                                        Text="{x:Bind DomainText}"
                                                        FontSize="11" />
                                                </Border>
                                                <Border
                                                    Padding="8,3"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock
                                                        Text="{x:Bind Category}"
                                                        FontSize="11" />
                                                </Border>
                                                <Border
                                                    Padding="8,3"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                    Visibility="{x:Bind IsReplied, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock
                                                        Text="已回复"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <Button
                                                Grid.Column="1"
                                                Padding="12,6"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource FeedbackVoteButtonStyle}"
                                                IsEnabled="{x:Bind CanVote}"
                                                Click="VoteButton_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="共鸣">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AccentFillColorSecondaryBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                                                    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                                                </Button.Resources>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon
                                                        Glyph="{x:Bind VoteGlyph, Mode=OneWay}"
                                                        FontSize="14"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    <TextBlock
                                                        Text="{x:Bind VoteActionText, Mode=OneWay}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel
                        MinHeight="260"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            Glyph="&#xE939;"
                            FontSize="40"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="还没有符合条件的反馈"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Button
            Margin="0,0,32,28"
            Padding="18,12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            CornerRadius="24"
            Style="{ThemeResource AccentButtonStyle}"
            Click="NewFeedbackButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;" FontSize="15" />
                <TextBlock Text="新反馈" FontWeight="SemiBold" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
