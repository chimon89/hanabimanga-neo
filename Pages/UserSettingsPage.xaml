<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.UserSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="SettingsScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Width="{Binding ElementName=SettingsScrollViewer, Path=ViewportWidth}"
                MinHeight="{Binding ElementName=SettingsScrollViewer, Path=ViewportHeight}"
                MaxWidth="1060"
                Padding="32,10,32,32"
                HorizontalAlignment="Center"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock
                        Text="用户设置"
                        FontSize="28"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="管理个人资料和账号"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="8">
                    <ProgressRing
                        HorizontalAlignment="Left"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Severity="Error"
                        Title="操作失败"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasFeedback, Mode=OneWay}"
                        Severity="Success"
                        Title="已完成"
                        Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    x:Name="SettingsListPanel"
                    Grid.Row="2"
                    Spacing="8">
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        CornerRadius="8"
                        Click="ProfileSectionButton_Click">
                        <Grid Padding="18,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE77B;"
                                FontSize="22"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="个人资料" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="用户名、显示名称"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontSize="12"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        CornerRadius="8"
                        Click="AvatarSectionButton_Click">
                        <Grid Padding="18,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE91F;"
                                FontSize="22"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="头像" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="选择预设头像或上传自定义头像"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontSize="12"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        CornerRadius="8"
                        Click="BannerSectionButton_Click">
                        <Grid Padding="18,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE7F4;"
                                FontSize="22"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="个人页横幅" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="更换主页 Banner"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontSize="12"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        CornerRadius="8"
                        Click="BadgesSectionButton_Click">
                        <Grid Padding="18,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xEA86;"
                                FontSize="22"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="个人徽章" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="选择哪些徽章展示在主页"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontSize="12"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        CornerRadius="8"
                        Click="EmailSectionButton_Click">
                        <Grid Padding="18,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE715;"
                                FontSize="22"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="邮箱" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="变更登录邮箱"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontSize="12"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        CornerRadius="8"
                        Click="PasswordSectionButton_Click">
                        <Grid Padding="18,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE72E;"
                                FontSize="22"
                                VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="密码" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="修改登录密码"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                Glyph="&#xE76C;"
                                FontSize="12"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <Grid
                    x:Name="DetailHost"
                    Grid.Row="2"
                    RowSpacing="12"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            Click="BackSettingsListButton_Click"
                            ToolTipService.ToolTip="返回">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        </Button>
                        <TextBlock
                            x:Name="SettingsDetailTitleTextBlock"
                            Grid.Column="1"
                            Text="设置"
                            FontSize="22"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Border
                            x:Name="ProfileDetailPanel"
                            Padding="18"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="Collapsed">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Width="96"
                                    Height="96"
                                    CornerRadius="48"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top">
                                    <Image
                                        Source="{x:Bind ViewModel.CurrentAvatarPreviewUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                                        Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="12">
                                    <TextBox
                                        x:Name="UsernameBox"
                                        Header="用户名"
                                        MaxLength="32"
                                        PlaceholderText="设置唯一用户名"
                                        Text="{x:Bind ViewModel.Username, Mode=OneWay}" />
                                    <TextBox
                                        x:Name="DisplayNameBox"
                                        Header="显示名称"
                                        MaxLength="32"
                                        PlaceholderText="公开显示的昵称"
                                        Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}" />
                                    <Button
                                        HorizontalAlignment="Left"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
                                        Click="SaveProfileButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                            <TextBlock Text="保存资料" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="AvatarDetailPanel"
                            Padding="18"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="Collapsed">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="72"
                                        Height="72"
                                        CornerRadius="36"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                        <Image
                                            Source="{x:Bind ViewModel.CurrentAvatarPreviewUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                                            Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock Text="当前头像" FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.CustomAvatarHint, Mode=OneWay}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        IsEnabled="{x:Bind ViewModel.CanUploadCustomAvatar, Mode=OneWay}"
                                        Click="ChooseCustomAvatarButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                                            <TextBlock Text="上传" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.AvatarPresets, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsJustification="Start"
                                            ItemsStretch="None"
                                            MinColumnSpacing="10"
                                            MinRowSpacing="10"
                                            MinItemWidth="68"
                                            MinItemHeight="68" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:AvatarPresetOption">
                                            <Button
                                                Width="64"
                                                Height="64"
                                                Padding="0"
                                                CornerRadius="32"
                                                Tag="{x:Bind FileName}"
                                                Click="AvatarPresetButton_Click"
                                                ToolTipService.ToolTip="{x:Bind Label}">
                                                <Image
                                                    Source="{x:Bind PreviewUrl, Converter={StaticResource StringToImageSource}}"
                                                    Stretch="UniformToFill" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="BannerDetailPanel"
                            Padding="18"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="Collapsed">
                            <StackPanel Spacing="14">
                                <Border
                                    Height="168"
                                    CornerRadius="8"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                    <Image
                                        Source="{x:Bind ViewModel.CurrentBannerPreviewUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                                        Stretch="UniformToFill" />
                                </Border>

                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.BannerPresets, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsJustification="Start"
                                            ItemsStretch="None"
                                            MinColumnSpacing="10"
                                            MinRowSpacing="10"
                                            MinItemWidth="150"
                                            MinItemHeight="70" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:BannerPresetOption">
                                            <Button
                                                Width="146"
                                                Height="66"
                                                Padding="0"
                                                CornerRadius="8"
                                                Tag="{x:Bind FileName}"
                                                Click="BannerPresetButton_Click"
                                                ToolTipService.ToolTip="{x:Bind Label}">
                                                <Image
                                                    Source="{x:Bind PreviewUrl, Converter={StaticResource StringToImageSource}}"
                                                    Stretch="UniformToFill" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="BadgesDetailPanel"
                            Padding="18"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="Collapsed">
                            <StackPanel Spacing="14">
                                <ItemsRepeater
                                    ItemsSource="{x:Bind ViewModel.Badges, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasBadges, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="10" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:UserBadgeItem">
                                            <Grid
                                                MinHeight="58"
                                                ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="42"
                                                    Height="42"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                                    <Image
                                                        Source="{x:Bind ImagePreviewUrl, Converter={StaticResource StringToImageSource}}"
                                                        Stretch="UniformToFill" />
                                                </Border>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="1">
                                                    <TextBlock
                                                        Text="{x:Bind Name}"
                                                        FontWeight="SemiBold"
                                                        MaxLines="1"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Text="{x:Bind DisplayStatus}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <Button
                                                    Grid.Column="2"
                                                    MinWidth="86"
                                                    VerticalAlignment="Center"
                                                    Tag="{x:Bind Id}"
                                                    Click="BadgeDisplayButton_Click">
                                                    <TextBlock Text="{x:Bind DisplayActionLabel}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <TextBlock
                                    Text="还没有可编辑的徽章"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind ViewModel.HasNoBadges, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="EmailDetailPanel"
                            Padding="18"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="Collapsed">
                            <StackPanel Spacing="12" MaxWidth="520" HorizontalAlignment="Left">
                                <TextBox
                                    x:Name="EmailBox"
                                    Header="新邮箱"
                                    PlaceholderText="name@example.com"
                                    Text="{x:Bind ViewModel.Email, Mode=OneWay}" />
                                <Button
                                    HorizontalAlignment="Left"
                                    IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
                                    Click="SaveEmailButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE715;" FontSize="13" />
                                        <TextBlock Text="变更邮箱" />
                                    </StackPanel>
                                </Button>
                                <TextBlock
                                    Text="邮箱变更通常需要根据邮件完成确认。"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="PasswordDetailPanel"
                            Padding="18"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="Collapsed">
                            <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Stretch">
                                <PasswordBox
                                    x:Name="CurrentPasswordBox"
                                    Width="640"
                                    Header="当前密码"
                                    PlaceholderText="输入当前密码以验证身份" />
                                <PasswordBox
                                    x:Name="PasswordBox"
                                    Width="640"
                                    Header="新密码"
                                    PlaceholderText="至少 6 位字符" />
                                <PasswordBox
                                    x:Name="PasswordConfirmBox"
                                    Width="640"
                                    Header="确认新密码"
                                    PlaceholderText="再次输入新密码" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
                                    Click="SavePasswordButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72E;" FontSize="13" />
                                        <TextBlock Text="修改密码" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
