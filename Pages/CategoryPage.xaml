<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.CategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 筛选区:四组选项各占单行,横向排列,超出可横向滚动 -->
        <Border
            Grid.Row="0"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid
                MaxWidth="1180"
                HorizontalAlignment="Stretch"
                Padding="32,14,32,14"
                RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="类型" Style="{StaticResource FilterLabelStyle}" />
                <ScrollViewer
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel x:Name="CategoryChips" Orientation="Horizontal" Spacing="8" />
                </ScrollViewer>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="排名" Style="{StaticResource FilterLabelStyle}" />
                <ScrollViewer
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel x:Name="SortChips" Orientation="Horizontal" Spacing="8" />
                </ScrollViewer>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="风格" Style="{StaticResource FilterLabelStyle}" />
                <ScrollViewer
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel x:Name="RegionChips" Orientation="Horizontal" Spacing="8" />
                </ScrollViewer>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="状态" Style="{StaticResource FilterLabelStyle}" />
                <ScrollViewer
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel x:Name="StatusChips" Orientation="Horizontal" Spacing="8" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 结果区 -->
        <ScrollViewer
            Grid.Row="1"
            x:Name="ResultsScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            ViewChanged="ResultsScrollViewer_ViewChanged">
            <Grid
                Width="{Binding ElementName=ResultsScrollViewer, Path=ViewportWidth}"
                MaxWidth="1180"
                Padding="32,18,32,32"
                HorizontalAlignment="Center"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    Grid.Row="0"
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Title="加载失败"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <Grid
                    Grid.Row="1"
                    MinHeight="360"
                    HorizontalAlignment="Stretch">
                    <ItemsRepeater
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsJustification="Start"
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinRowSpacing="14"
                                MinItemWidth="170"
                                MinItemHeight="320" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:ComicListItem">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Padding="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="10"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Click="ComicItem_Click"
                                    Tag="{x:Bind Id}"
                                    ToolTipService.ToolTip="{x:Bind Title}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="226" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Image
                                                Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSource}}"
                                                Stretch="UniformToFill" />
                                        </Border>

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{x:Bind Title}"
                                            FontWeight="SemiBold"
                                            LineHeight="20"
                                            Height="40"
                                            Margin="2,8,2,0"
                                            MaxLines="2"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Text="{x:Bind Subtitle}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Margin="2,4,2,0"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon
                            Glyph="&#xE721;"
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="没有符合条件的漫画"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <ProgressRing
                    Grid.Row="2"
                    Width="22"
                    Height="22"
                    IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
