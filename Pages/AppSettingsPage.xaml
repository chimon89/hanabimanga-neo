<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="SettingsScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Width="{Binding ElementName=SettingsScrollViewer, Path=ViewportWidth}"
                MinHeight="{Binding ElementName=SettingsScrollViewer, Path=ViewportHeight}"
                MaxWidth="1040"
                Padding="32,10,32,32"
                HorizontalAlignment="Center"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel MinWidth="0" Spacing="1">
                        <TextBlock
                            Text="应用设置"
                            FontSize="24"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="阅读、缓存与下载"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Padding="12,6"
                        Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Spacing="8">
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <InfoBar
                        IsClosable="False"
                        Severity="Error"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Title="操作失败"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                    <InfoBar
                        IsClosable="False"
                        Severity="Success"
                        IsOpen="{x:Bind ViewModel.HasFeedback, Mode=OneWay}"
                        Title="已完成"
                        Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}" />
                </StackPanel>

                <Grid
                    Grid.Row="2"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 外观配色 -->
                    <Border
                        Grid.Row="0"
                        Padding="18"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="外观配色"
                                    FontSize="17"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="选择强调色,背景与卡片会随之换色,切换后立即生效"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.AccentColorOptions, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        Orientation="Horizontal"
                                        MinItemWidth="92"
                                        MinItemHeight="84"
                                        MinColumnSpacing="4"
                                        MinRowSpacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ThemeColorOption">
                                        <Button
                                            Padding="6"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Center"
                                            Click="AccentSwatch_Click"
                                            Tag="{x:Bind Id}"
                                            ToolTipService.ToolTip="{x:Bind Name}">
                                            <StackPanel Spacing="6">
                                                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                                                    <Ellipse
                                                        Width="44"
                                                        Height="44"
                                                        Fill="{x:Bind Swatch}" />
                                                    <Ellipse
                                                        Width="44"
                                                        Height="44"
                                                        StrokeThickness="2"
                                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                    <FontIcon
                                                        Glyph="&#xE73E;"
                                                        FontSize="16"
                                                        Foreground="White"
                                                        Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                                <TextBlock
                                                    Text="{x:Bind Name}"
                                                    FontSize="12"
                                                    HorizontalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- 接口线路 -->
                    <Border
                        Grid.Row="1"
                        Padding="18"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="接口线路"
                                    FontSize="17"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ActiveEndpointText, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Grid
                                Grid.Row="1"
                                ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="1">
                                    <TextBlock
                                        Text="接口地址"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="国内用户推荐使用加速线路,切换后立即生效"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="200"
                                    SelectedIndex="{x:Bind ViewModel.ApiEndpointSelectedIndex, Mode=OneWay}"
                                    SelectionChanged="ApiEndpointComboBox_SelectionChanged">
                                    <ComboBoxItem Content="自动选择" />
                                    <ComboBoxItem Content="国际线路" />
                                    <ComboBoxItem Content="国内加速" />
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 阅读缓存 -->
                    <Border
                        Grid.Row="2"
                        Padding="18"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="阅读缓存"
                                        FontSize="17"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.CacheSummary, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Padding="12,6"
                                    Click="ClearCacheButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        <TextBlock Text="清理缓存" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid
                                Grid.Row="1"
                                ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="阅读器模式"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                                <ComboBox
                                    Grid.Column="1"
                                    Width="168"
                                    SelectedIndex="{x:Bind ViewModel.ReaderViewModeSelectedIndex, Mode=OneWay}"
                                    SelectionChanged="ReaderViewModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="翻页模式" />
                                    <ComboBoxItem Content="瀑布流模式" />
                                </ComboBox>
                            </Grid>

                            <Grid
                                Grid.Row="2"
                                ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="缓存图片"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{x:Bind ViewModel.EnableReaderCache, Mode=OneWay}"
                                    Toggled="ReaderCacheToggle_Toggled"
                                    OnContent="开启"
                                    OffContent="关闭" />
                            </Grid>

                            <Grid
                                Grid.Row="3"
                                ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="预载页面"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsEnabled="{x:Bind ViewModel.CanUsePreload, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.EnableReaderPreload, Mode=OneWay}"
                                    Toggled="ReaderPreloadToggle_Toggled"
                                    OnContent="开启"
                                    OffContent="关闭" />
                            </Grid>

                            <Grid
                                Grid.Row="4"
                                ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="预载页数"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                                <Slider
                                    Grid.Column="1"
                                    Minimum="1"
                                    Maximum="8"
                                    Background="{ThemeResource ControlFillColorTransparentBrush}"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    StepFrequency="1"
                                    SmallChange="1"
                                    LargeChange="1"
                                    Value="{x:Bind ViewModel.PreloadPageCountValue, Mode=OneWay}"
                                    ValueChanged="PreloadPageCountSlider_ValueChanged" />
                                <TextBlock
                                    Grid.Column="2"
                                    MinWidth="40"
                                    Text="{x:Bind ViewModel.PreloadPageCountText, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="3"
                        Padding="18"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="下载管理"
                                    FontSize="17"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.DownloadSummary, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ItemsRepeater
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.Downloads, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasDownloads, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:DownloadTaskItem">
                                        <Border
                                            Padding="12"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon
                                                    Grid.Column="0"
                                                    Glyph="&#xE896;"
                                                    FontSize="18"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                <StackPanel
                                                    Grid.Column="1"
                                                    MinWidth="0"
                                                    Spacing="3">
                                                    <TextBlock
                                                        Text="{x:Bind Title}"
                                                        FontWeight="SemiBold"
                                                        MaxLines="1"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                                            Text="{x:Bind QualityText}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock
                                                            Text="{x:Bind ProgressText}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock
                                                            Text="{x:Bind SizeText}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Text="{x:Bind ErrorMessage}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                        MaxLines="1"
                                                        TextTrimming="CharacterEllipsis"
                                                        Visibility="{x:Bind HasError, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="{x:Bind StatusText}"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                                <Button
                                                    Grid.Column="3"
                                                    Width="34"
                                                    Height="34"
                                                    Padding="0"
                                                    Click="DeleteDownloadButton_Click"
                                                    Tag="{x:Bind Id}"
                                                    ToolTipService.ToolTip="删除下载">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <StackPanel
                                Grid.Row="2"
                                Padding="24"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.IsDownloadsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <FontIcon
                                    Glyph="&#xE896;"
                                    FontSize="28"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock
                                    Text="暂无下载"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
