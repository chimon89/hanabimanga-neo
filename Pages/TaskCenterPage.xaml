<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.TaskCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="TaskCenterScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Width="{Binding ElementName=TaskCenterScrollViewer, Path=ViewportWidth}"
                MinHeight="{Binding ElementName=TaskCenterScrollViewer, Path=ViewportHeight}"
                MaxWidth="1040"
                Padding="32,12,32,36"
                HorizontalAlignment="Center"
                RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="任务中心"
                        FontSize="28"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />

                    <Button
                        Grid.Column="1"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </Grid>

                <InfoBar
                    Grid.Row="1"
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <Border
                    Grid.Row="2"
                    Padding="28,22"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="#40FFFFFF"
                    Background="{ThemeResource PointsPanelBackgroundBrush}">
                    <Grid ColumnSpacing="18" RowSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    Glyph="&#xE734;"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    FontSize="15" />
                                <TextBlock
                                    Text="我的积分"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Points, Mode=OneWay}"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    FontSize="48"
                                    FontWeight="SemiBold" />
                                <Border
                                    Padding="10,4"
                                    CornerRadius="12"
                                    Background="#30FFFFFF"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.TodayPointsText, Mode=OneWay}"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            MinWidth="190"
                            HorizontalAlignment="Left"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="PointStoreButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    Glyph="&#xE719;"
                                    FontSize="15"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                <TextBlock
                                    Text="会员商城"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            MinWidth="190"
                            Click="PointDetailButton_Click">
                            <TextBlock Text="积分明细" />
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Spacing="10">
                    <TextBlock
                        Text="每日签到"
                        FontSize="20"
                        FontWeight="SemiBold" />
                    <Border
                        Padding="18"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock
                                    Text="签到再领 5 章超分额度"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SignInStreakText, Mode=OneWay}"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    FontWeight="SemiBold" />
                            </Grid>

                            <ItemsRepeater
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.SignInDays, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        Orientation="Horizontal"
                                        ItemsJustification="SpaceAround"
                                        MinItemWidth="86"
                                        MinItemHeight="76" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:TaskCenterSignInDay">
                                        <StackPanel Spacing="6" Opacity="{x:Bind Opacity}">
                                            <TextBlock
                                                Text="{x:Bind Label}"
                                                FontSize="12"
                                                HorizontalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Border
                                                Width="52"
                                                Height="52"
                                                CornerRadius="10"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                                                    <FontIcon
                                                        Glyph="{x:Bind StatusGlyph}"
                                                        FontSize="13"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    <TextBlock
                                                        Text="{x:Bind PointsText}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Button
                                Grid.Row="2"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="48"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="SignInButton_Click">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SignInButtonText, Mode=OneWay}"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="4" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="每日任务" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{x:Bind ViewModel.DailyTaskSummary, Mode=OneWay}"
                            VerticalAlignment="Bottom"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.DailyTasks, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskCenterTaskItem">
                                <Border
                                    Padding="14"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid ColumnSpacing="14" MinHeight="56" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="48"
                                            Height="48"
                                            CornerRadius="10"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <FontIcon
                                                Glyph="{x:Bind IconGlyph}"
                                                FontSize="24"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind RewardText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{x:Bind Description}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <ProgressBar
                                                Height="4"
                                                Value="{x:Bind ProgressValue}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock
                                                Text="{x:Bind ProgressText}"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Right" />
                                            <TextBlock
                                                Text="{x:Bind StatusText}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <StackPanel Grid.Row="5" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="一次性任务" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{x:Bind ViewModel.OneTimeTaskSummary, Mode=OneWay}"
                            VerticalAlignment="Bottom"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.OneTimeTasks, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskCenterTaskItem">
                                <Border
                                    Padding="14"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="48"
                                            Height="48"
                                            CornerRadius="10"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <FontIcon
                                                Glyph="{x:Bind IconGlyph}"
                                                FontSize="23"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind StatusText}"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <StackPanel Grid.Row="6" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="长期任务" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LongTermTaskSummary, Mode=OneWay}"
                            VerticalAlignment="Bottom"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.LongTermTasks, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskCenterTaskItem">
                                <Button
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Tag="{x:Bind Id}"
                                    Click="LongTermTaskButton_Click">
                                    <Border
                                        Padding="14"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid ColumnSpacing="14" MinHeight="56" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="48"
                                                Height="48"
                                                CornerRadius="10"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                <FontIcon
                                                    Glyph="{x:Bind IconGlyph}"
                                                    FontSize="23"
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{x:Bind StatusText}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <FontIcon
                                                    Glyph="&#xE76C;"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>
