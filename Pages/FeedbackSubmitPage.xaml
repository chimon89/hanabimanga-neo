<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.FeedbackSubmitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="SubmitScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Width="{Binding ElementName=SubmitScrollViewer, Path=ViewportWidth}"
                MaxWidth="780"
                Padding="32,18,32,40"
                HorizontalAlignment="Center"
                Spacing="16">

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Width="38"
                        Height="38"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>

                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock
                            Text="提交反馈"
                            FontSize="28"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="精准填写有助于更快受理与跟踪"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <Border
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="创建工单" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock
                            Text="选择反馈类型与问题分类,填写标题后即可提交。"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind ViewModel.QuotaText, Mode=OneWay}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind ViewModel.HasQuota, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- 反馈类型 -->
                <Border
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="反馈类型" FontSize="16" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="DomainDevButton"
                                MinHeight="48"
                                HorizontalAlignment="Stretch"
                                Click="DomainDevButton_Click"
                                Content="功能反馈" />
                            <Button
                                x:Name="DomainOpsButton"
                                Grid.Column="1"
                                MinHeight="48"
                                HorizontalAlignment="Stretch"
                                Click="DomainOpsButton_Click"
                                Content="资源反馈" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 问题分类 -->
                <Border
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.HasDomain, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="问题分类" FontSize="16" FontWeight="SemiBold" />
                        <StackPanel
                            x:Name="CategoryChips"
                            Orientation="Horizontal"
                            Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- 求书:Bangumi 搜索 -->
                <Border
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.IsBookRequest, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="搜索书籍" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock
                            Text="从 Bangumi 搜索并选择你想要的书籍,我们会根据条目信息进行匹配。"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="BangumiSearchBox"
                                PlaceholderText="输入书名搜索 Bangumi…"
                                KeyDown="BangumiSearchBox_KeyDown" />
                            <Button
                                Grid.Column="1"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="BangumiSearchButton_Click"
                                Content="搜索" />
                        </Grid>

                        <ProgressRing
                            HorizontalAlignment="Left"
                            IsActive="{x:Bind ViewModel.IsSearchingBangumi, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsSearchingBangumi, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock
                            Text="{x:Bind ViewModel.BangumiHint, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasBangumiHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 已选条目 -->
                        <Border
                            Padding="12"
                            CornerRadius="8"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.HasSelectedBangumiBook, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="44"
                                    Height="60"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Image
                                        Source="{x:Bind ViewModel.SelectedBangumiBook.CoverPreviewUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                                        Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedBangumiBook.DisplayName, Mode=OneWay}"
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedBangumiBook.SubText, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="ClearBangumiButton_Click"
                                    Content="更换" />
                            </Grid>
                        </Border>

                        <ItemsRepeater
                            ItemsSource="{x:Bind ViewModel.BangumiResults, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowBangumiResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:BangumiBook">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10"
                                        Click="BangumiResult_Click">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="40"
                                                Height="56"
                                                CornerRadius="6"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <Image
                                                    Source="{x:Bind CoverPreviewUrl, Converter={StaticResource StringToImageSource}}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock
                                                    Text="{x:Bind DisplayName}"
                                                    FontWeight="SemiBold"
                                                    MaxLines="1"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind SubText}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- 资源缺失 / 不匹配:关联现有漫画 -->
                <Border
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.IsComicAssociation, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="关联现有漫画（可选）" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock
                            Text="搜索并选择对应漫画,有助于我们更快定位资源问题。"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="ComicSearchBox"
                                PlaceholderText="输入漫画名搜索…"
                                KeyDown="ComicSearchBox_KeyDown" />
                            <Button
                                Grid.Column="1"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="ComicSearchButton_Click"
                                Content="搜索" />
                        </Grid>

                        <ProgressRing
                            HorizontalAlignment="Left"
                            IsActive="{x:Bind ViewModel.IsSearchingComic, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsSearchingComic, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock
                            Text="{x:Bind ViewModel.ComicHint, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasComicHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <Border
                            Padding="12"
                            CornerRadius="8"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.HasSelectedComic, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="44"
                                    Height="60"
                                    CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Image
                                        Source="{x:Bind ViewModel.SelectedComic.CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                                        Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedComic.Title, Mode=OneWay}"
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedComic.Subtitle, Mode=OneWay}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="ClearComicButton_Click"
                                    Content="取消关联" />
                            </Grid>
                        </Border>

                        <ItemsRepeater
                            ItemsSource="{x:Bind ViewModel.ComicResults, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowComicResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:ComicListItem">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10"
                                        Click="ComicResult_Click">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="40"
                                                Height="56"
                                                CornerRadius="6"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <Image
                                                    Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSource}}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock
                                                    Text="{x:Bind Title}"
                                                    FontWeight="SemiBold"
                                                    MaxLines="1"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind Subtitle}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- 标题与描述 -->
                <Border
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBox
                            x:Name="TitleTextBox"
                            Header="工单标题（必填）"
                            MaxLength="80"
                            PlaceholderText="一句话描述你的反馈"
                            TextChanged="TitleTextBox_TextChanged" />
                        <TextBox
                            x:Name="DescriptionTextBox"
                            Header="详细描述（可选）"
                            AcceptsReturn="True"
                            MaxLength="1000"
                            MinHeight="108"
                            TextWrapping="Wrap"
                            PlaceholderText="补充更多细节有助于更快受理"
                            TextChanged="DescriptionTextBox_TextChanged" />
                    </StackPanel>
                </Border>

                <InfoBar
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Title="提交失败"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                <InfoBar
                    IsClosable="False"
                    Severity="Success"
                    IsOpen="{x:Bind ViewModel.HasFeedback, Mode=OneWay}"
                    Title="已提交"
                    Message="{x:Bind ViewModel.FeedbackMessage, Mode=OneWay}" />

                <!-- 提交入口 -->
                <Border
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE946;"
                                FontSize="18"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SubmitHintTitle, Mode=OneWay}"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SubmitHintText, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Button
                            HorizontalAlignment="Stretch"
                            MinHeight="44"
                            Style="{ThemeResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
                            Click="SubmitButton_Click"
                            Content="{x:Bind ViewModel.SubmitButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
