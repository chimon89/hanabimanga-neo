<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.PointsStorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="PointsStoreScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Width="{Binding ElementName=PointsStoreScrollViewer, Path=ViewportWidth}"
                MinHeight="{Binding ElementName=PointsStoreScrollViewer, Path=ViewportHeight}"
                MaxWidth="980"
                Padding="32,12,32,36"
                HorizontalAlignment="Center"
                RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" />
                    </Button>
                    <TextBlock
                        Grid.Column="1"
                        Text="积分商城"
                        FontSize="26"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="2"
                        Width="40"
                        Height="40"
                        Padding="0"
                        Click="ExchangeHistoryButton_Click"
                        ToolTipService.ToolTip="我的兑换">
                        <FontIcon Glyph="&#xE8D1;" FontSize="18" />
                    </Button>
                </Grid>

                <InfoBar
                    Grid.Row="1"
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <Border
                    Grid.Row="2"
                    Padding="22"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE734;"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                FontSize="18" />
                            <TextBlock
                                Text="可用积分"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.Points, Mode=OneWay}"
                            FontSize="34"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3" Spacing="10">
                    <TextBlock
                        Text="虚拟奖励"
                        FontSize="18"
                        FontWeight="SemiBold" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.VirtualStoreItems, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:PointStoreItem">
                                <Border
                                    Padding="16"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="54"
                                            Height="54"
                                            CornerRadius="10"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                            <FontIcon
                                                Glyph="{x:Bind IconGlyph}"
                                                FontSize="25"
                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{x:Bind Description}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind PointsText}"
                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            MinWidth="96"
                                            VerticalAlignment="Center"
                                            Content="{x:Bind ActionText}"
                                            Click="StoreItemButton_Click"
                                            Tag="{x:Bind Id}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <StackPanel Grid.Row="4" Spacing="10">
                    <TextBlock
                        Text="实物奖励"
                        FontSize="18"
                        FontWeight="SemiBold" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.PhysicalStoreItems, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:PointStoreItem">
                                <Border
                                    Padding="16"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="54"
                                            Height="54"
                                            CornerRadius="10"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                            <FontIcon
                                                Glyph="{x:Bind IconGlyph}"
                                                FontSize="25"
                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{x:Bind Description}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock
                                                    Text="{x:Bind PointsText}"
                                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                    FontWeight="SemiBold" />
                                                <TextBlock
                                                    Text="{x:Bind StockText}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            MinWidth="96"
                                            VerticalAlignment="Center"
                                            Content="{x:Bind ActionText}"
                                            Click="StoreItemButton_Click"
                                            Tag="{x:Bind Id}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Page>
