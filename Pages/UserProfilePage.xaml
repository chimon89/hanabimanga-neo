<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.UserProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="ProfileScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Width="{Binding ElementName=ProfileScrollViewer, Path=ViewportWidth}"
                MinHeight="{Binding ElementName=ProfileScrollViewer, Path=ViewportHeight}"
                MaxWidth="920"
                Padding="32,18,32,32"
                HorizontalAlignment="Center"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Width="38"
                        Height="38"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>

                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />

                    <Button
                        Grid.Column="2"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ProgressRing
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <InfoBar
                    Grid.Row="2"
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Title="加载失败"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <StackPanel
                    Grid.Row="3"
                    Spacing="0"
                    Visibility="{x:Bind ViewModel.HasProfile, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="190" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            CornerRadius="8"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}">
                            <Image
                                Source="{x:Bind ViewModel.BannerPreviewUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                                Stretch="UniformToFill" />
                        </Border>

                        <Grid
                            Grid.Row="1"
                            MinHeight="150"
                            Padding="18,0,18,18"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="5">
                                <Border
                                    Width="104"
                                    Height="104"
                                    Margin="0,-52,0,4"
                                    CornerRadius="52"
                                    BorderThickness="4"
                                    BorderBrush="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                    HorizontalAlignment="Left">
                                    <Image
                                        Source="{x:Bind ViewModel.AvatarPreviewUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                                        Stretch="UniformToFill" />
                                </Border>

                                <Grid
                                    ColumnSpacing="7"
                                    HorizontalAlignment="Left"
                                    MaxWidth="620">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <Viewbox
                                        Grid.Column="1"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Margin="0,4,0,0"
                                        Visibility="{x:Bind ViewModel.IsEmailVerified, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                        ToolTipService.ToolTip="已验证用户">
                                        <Grid Width="22" Height="22">
                                            <Path
                                                Data="M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44S11.647 1.62 11 1.604c-.646.017-1.273.213-1.813.568s-.969.854-1.24 1.44c-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245-.356.54-.555 1.17-.574 1.817.02.647.218 1.276.574 1.817.356.54.856.972 1.443 1.245-.224.606-.274 1.263-.144 1.896.13.634.433 1.218.877 1.688.47.443 1.054.747 1.687.878.633.132 1.29.084 1.897-.136.274.586.705 1.084 1.246 1.439.54.354 1.17.551 1.816.569.647-.016 1.276-.213 1.817-.567s.972-.854 1.245-1.44c.604.239 1.266.296 1.903.164.636-.132 1.22-.447 1.68-.907.46-.46.776-1.044.908-1.681s.075-1.299-.165-1.903c.586-.274 1.084-.705 1.439-1.246.354-.54.551-1.17.569-1.816z"
                                                Fill="#1D9BF0" />
                                            <Path
                                                Data="M9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246z"
                                                Fill="White" />
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                                <TextBlock
                                    Text="{x:Bind ViewModel.UsernameText, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="14"
                                    Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            Glyph="&#xE787;"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.JoinedText, Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock
                                        Text="{x:Bind ViewModel.StatsText, Mode=OneWay}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Margin="0,24,0,0"
                                VerticalAlignment="Top"
                                Visibility="{x:Bind ViewModel.IsSelf, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                Click="EditProfileButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                    <TextBlock Text="编辑资料" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <ItemsRepeater
                        ItemsSource="{x:Bind ViewModel.Timeline, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasTimeline, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:UserTimelineItem">
                                <Grid
                                    Padding="18,14"
                                    ColumnSpacing="12"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="34"
                                        Height="34"
                                        CornerRadius="17"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <FontIcon
                                            Glyph="{x:Bind IconGlyph}"
                                            FontSize="15"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Spacing="8">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Text="{x:Bind Title}"
                                                FontWeight="SemiBold"
                                                TextWrapping="WrapWholeWords" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind CreatedAtText}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>

                                        <TextBlock
                                            Text="{x:Bind Body}"
                                            TextWrapping="WrapWholeWords"
                                            LineHeight="22"
                                            Visibility="{x:Bind HasBody, Converter={StaticResource BoolToVisibility}}" />

                                        <Button
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Stretch"
                                            Click="TimelineComic_Click"
                                            Tag="{x:Bind NavigationComicId}"
                                            Visibility="{x:Bind HasComic, Converter={StaticResource BoolToVisibility}}">
                                            <Border
                                                Padding="10"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Width="54"
                                                        Height="76"
                                                        CornerRadius="6"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                        <Image
                                                            Source="{x:Bind ComicCoverUrl, Converter={StaticResource StringToImageSource}}"
                                                            Stretch="UniformToFill" />
                                                    </Border>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="4">
                                                        <TextBlock
                                                            Text="{x:Bind ComicTitle}"
                                                            FontWeight="SemiBold"
                                                            MaxLines="2"
                                                            TextWrapping="WrapWholeWords"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Text="{x:Bind Meta}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel
                        MinHeight="220"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,48,0,48"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.HasNoTimeline, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            Glyph="&#xE8BA;"
                            FontSize="40"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="暂时还没有公开动态"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

