<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="DiscoverScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Width="{Binding ElementName=DiscoverScrollViewer, Path=ViewportWidth}"
                MaxWidth="1180"
                Padding="32,18,32,32"
                HorizontalAlignment="Center"
                RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        MinWidth="0"
                        Spacing="4">
                        <TextBlock
                            Text="发现"
                            FontSize="28"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="随机推荐一批漫画，也可以手动搜索"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Padding="12,6"
                        Click="ShuffleButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="换一换" />
                        </StackPanel>
                    </Button>
                </Grid>

                <AutoSuggestBox
                    Grid.Row="1"
                    x:Name="DiscoverSearchBox"
                    MinWidth="0"
                    MaxWidth="560"
                    HorizontalAlignment="Stretch"
                    QueryIcon="Find"
                    PlaceholderText="搜索漫画、别名、拼音"
                    QuerySubmitted="DiscoverSearchBox_QuerySubmitted" />

                <ProgressRing
                    Grid.Row="2"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <InfoBar
                    Grid.Row="3"
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Title="发现页加载失败"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <StackPanel Grid.Row="4" Spacing="4">
                    <TextBlock
                        Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}"
                        FontSize="20"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SectionSummary, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Grid
                    Grid.Row="5"
                    MinHeight="360"
                    MinWidth="0"
                    HorizontalAlignment="Stretch">
                    <ItemsRepeater
                        MinWidth="0"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsJustification="Start"
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinRowSpacing="14"
                                MinItemWidth="170"
                                MinItemHeight="320" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:ComicListItem">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Padding="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="10"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Click="ComicItem_Click"
                                    Tag="{x:Bind Id}"
                                    ToolTipService.ToolTip="{x:Bind Title}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="226" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Image
                                                Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSource}}"
                                                Stretch="UniformToFill" />
                                        </Border>

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{x:Bind Title}"
                                            FontWeight="SemiBold"
                                            LineHeight="20"
                                            Height="40"
                                            Margin="2,8,2,0"
                                            MaxLines="2"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Text="{x:Bind Subtitle}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Margin="2,4,2,0"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind ShowSubtitle, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon
                            Glyph="&#xE721;"
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="没有找到漫画"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
