<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="hanabimanga.Pages.AnnouncementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="公告">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource SakuraMicaOverlayBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CloseAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!--  自定义 TitleBar:系统标题栏由 OverlappedPresenter.SetBorderAndTitleBar 关闭  -->
        <Grid
            Grid.Row="0"
            Background="Transparent"
            BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Width="46"
                Height="44"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="0"
                Click="BackButton_Click"
                ToolTipService.ToolTip="返回">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>

            <TextBlock
                x:Name="WindowTitleText"
                Grid.Column="1"
                Margin="4,0,20,0"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="公告"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="760"
                Padding="40,28,40,40"
                HorizontalAlignment="Center"
                Spacing="20">

                <ProgressRing
                    x:Name="LoadingRing"
                    IsActive="True"
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0" />

                <InfoBar
                    x:Name="ErrorBar"
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="False"
                    Title="加载失败" />

                <StackPanel
                    x:Name="ContentPanel"
                    Visibility="Collapsed"
                    Spacing="16">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            x:Name="TypeBadge"
                            Padding="10,4"
                            CornerRadius="6"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock
                                x:Name="TypeBadgeText"
                                Text="公告"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock
                            x:Name="CreatedAtText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="TitleText"
                        FontSize="26"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="SummaryText"
                        FontSize="15"
                        LineHeight="24"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <Border
                        x:Name="DetailDivider"
                        Height="1"
                        Margin="0,4,0,0"
                        Visibility="Collapsed"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel
                        x:Name="DetailPanel"
                        Spacing="12"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="ActionButton"
                        Visibility="Collapsed"
                        Style="{ThemeResource AccentButtonStyle}"
                        Padding="16,8"
                        HorizontalAlignment="Left"
                        Click="ActionButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
