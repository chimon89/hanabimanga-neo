<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="hanabimanga.Pages.AnnouncementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="公告">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="760"
                Padding="40,32,40,40"
                HorizontalAlignment="Center"
                Spacing="20">

                <ProgressRing
                    x:Name="LoadingRing"
                    IsActive="True"
                    HorizontalAlignment="Center"
                    Margin="0,40,0,0" />

                <InfoBar
                    x:Name="ErrorBar"
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="False"
                    Title="加载失败" />

                <StackPanel
                    x:Name="ContentPanel"
                    Visibility="Collapsed"
                    Spacing="16">

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border
                            x:Name="TypeBadge"
                            Padding="10,4"
                            CornerRadius="6"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}">
                            <TextBlock
                                x:Name="TypeBadgeText"
                                Text="公告"
                                FontSize="12"
                                FontWeight="SemiBold" />
                        </Border>
                        <TextBlock
                            x:Name="CreatedAtText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="TitleText"
                        FontSize="26"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="SummaryText"
                        FontSize="15"
                        LineHeight="24"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <Border
                        x:Name="DetailDivider"
                        Height="1"
                        Margin="0,4,0,0"
                        Visibility="Collapsed"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock
                        x:Name="DetailText"
                        FontSize="14"
                        LineHeight="24"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="ActionButton"
                        Visibility="Collapsed"
                        Style="{ThemeResource AccentButtonStyle}"
                        Padding="16,8"
                        HorizontalAlignment="Left"
                        Click="ActionButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
