<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="SearchScrollViewer"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Width="{Binding ElementName=SearchScrollViewer, Path=ActualWidth}"
                MaxWidth="1180"
                Padding="32,18,32,32"
                HorizontalAlignment="Center"
                Spacing="18">

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        FontSize="28"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <InfoBar
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Title="搜索失败"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <Grid
                    MinHeight="360"
                    HorizontalAlignment="Stretch">
                    <ItemsRepeater
                        ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsJustification="Start"
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinRowSpacing="14"
                                MinItemWidth="176"
                                MinItemHeight="320" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:ComicListItem">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Padding="10"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="10"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Click="ComicItem_Click"
                                    Tag="{x:Bind Id}"
                                    ToolTipService.ToolTip="{x:Bind Title}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="226" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <Image
                                                Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSource}}"
                                                Stretch="UniformToFill" />
                                        </Border>

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{x:Bind Title}"
                                            FontWeight="SemiBold"
                                            LineHeight="20"
                                            Height="40"
                                            Margin="2,8,2,0"
                                            MaxLines="2"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Text="{x:Bind Subtitle}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Margin="2,4,2,0"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon
                            Glyph="&#xE721;"
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock
                            Text="没有找到匹配的漫画"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
