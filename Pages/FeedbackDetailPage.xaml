<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.FeedbackDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="FeedbackVoteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="22" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="DetailScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Width="{Binding ElementName=DetailScrollViewer, Path=ViewportWidth}"
                MaxWidth="780"
                Padding="32,18,32,40"
                HorizontalAlignment="Center"
                Spacing="16">

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Width="38"
                        Height="38"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="反馈详情"
                        FontSize="28"
                        FontWeight="SemiBold" />
                </Grid>

                <!-- 工单内容卡片 -->
                <Border
                    Padding="16"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.HasTicket, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Padding="10,4"
                                VerticalAlignment="Center"
                                CornerRadius="6"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Ticket.StatusText, Mode=OneWay}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Right">
                                <Border
                                    Padding="8,3"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Ticket.DomainText, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <Border
                                    Padding="8,3"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Ticket.Category, Mode=OneWay}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="{x:Bind ViewModel.Ticket.Title, Mode=OneWay}"
                            FontSize="20"
                            FontWeight="SemiBold"
                            TextWrapping="WrapWholeWords" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Width="26"
                                Height="26"
                                CornerRadius="13"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                <Image
                                    Source="{x:Bind ViewModel.Ticket.AvatarPreviewUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                                    Stretch="UniformToFill" />
                            </Border>
                            <TextBlock
                                Text="{x:Bind ViewModel.Ticket.ReporterName, Mode=OneWay}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="·"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Ticket.CreatedAtText, Mode=OneWay}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock
                            Text="{x:Bind ViewModel.Ticket.Description, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            LineHeight="22"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind ViewModel.Ticket.HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock
                            Text="{x:Bind ViewModel.Ticket.RelationText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="WrapWholeWords"
                            Visibility="{x:Bind ViewModel.Ticket.HasRelation, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <InfoBar
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Title="操作失败"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <!-- 受影响人数 + 共鸣按钮 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.VoteCountLabel, Mode=OneWay}"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.VoteCountText, Mode=OneWay}"
                            FontSize="32"
                            FontWeight="SemiBold" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Padding="16,10"
                        VerticalAlignment="Center"
                        Style="{StaticResource FeedbackVoteButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanVote, Mode=OneWay}"
                        Click="VoteButton_Click">
                        <Button.Resources>
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="AccentFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="AccentFillColorSecondaryBrush" />
                            <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="AccentFillColorDisabledBrush" />
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="{x:Bind ViewModel.VoteGlyph, Mode=OneWay}"
                                FontSize="15"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.VoteButtonText, Mode=OneWay}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            Glyph="&#xE939;"
                            FontSize="15"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.VoteUsersLabel, Mode=OneWay}"
                            FontSize="16"
                            FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.VoterCountText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <ProgressRing
                    HorizontalAlignment="Left"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <ItemsRepeater
                    ItemsSource="{x:Bind ViewModel.Voters, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasVoters, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:TicketVoter">
                            <Grid ColumnSpacing="12" Padding="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                    <Image
                                        Source="{x:Bind AvatarPreviewUrl, Converter={StaticResource StringToImageSource}}"
                                        Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        Text="{x:Bind Name}"
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{x:Bind VotedAtText}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <StackPanel
                    MinHeight="160"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.ShowEmptyVoters, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        Glyph="&#xE939;"
                        FontSize="34"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.EmptyVotersText, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
