<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.ComicDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:hanabimanga.Models"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            Padding="0,0,0,28"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1220"
                Padding="32,18,32,32"
                HorizontalAlignment="Center"
                Spacing="20">

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <InfoBar
                    IsClosable="False"
                    Severity="Error"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Title="加载失败"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <StackPanel
                    Spacing="22"
                    Visibility="{x:Bind ViewModel.HasDetail, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">

                    <Border
                        Padding="20"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="176"
                                Height="252"
                                CornerRadius="8"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Image
                                    Source="{x:Bind ViewModel.CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                                    Stretch="UniformToFill" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="12"
                                VerticalAlignment="Top">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    TextWrapping="WrapWholeWords"
                                    MaxLines="2" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE77B;"
                                        FontSize="13"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.AuthorsText, Mode=OneWay}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Padding="10,4"
                                        CornerRadius="6"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                            FontSize="12"
                                            FontWeight="SemiBold" />
                                    </Border>
                                    <Border
                                        Padding="10,4"
                                        CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.ChapterCountText, Mode=OneWay}"
                                                FontSize="12"
                                                FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Padding="10,4"
                                        CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE735;" FontSize="12" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.RatingText, Mode=OneWay}"
                                                FontSize="12"
                                                FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Padding="10,4"
                                        CornerRadius="6"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.ReleaseText, Mode=OneWay}"
                                            FontSize="12"
                                            FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <TextBlock
                                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords"
                                    LineHeight="22"
                                    MaxLines="5" />

                                <Border
                                    Height="1"
                                    Margin="0,2,0,0"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <ItemsRepeater
                                    ItemsSource="{x:Bind ViewModel.TagChips, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsJustification="Start"
                                            ItemsStretch="None"
                                            MinColumnSpacing="8"
                                            MinRowSpacing="8"
                                            MinItemWidth="74"
                                            MinItemHeight="28" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                MinWidth="64"
                                                MaxWidth="132"
                                                Height="28"
                                                Padding="10,4"
                                                CornerRadius="6"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                <TextBlock
                                                    Text="{Binding}"
                                                    FontSize="12"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE734;" FontSize="13" />
                                <TextBlock Text="收藏" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8E1;" FontSize="13" />
                                <TextBlock Text="点赞" />
                            </StackPanel>
                        </Button>
                        <Button Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE735;" FontSize="13" />
                                <TextBlock Text="评分" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border
                        Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <Grid>
                        <StackPanel Spacing="14">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Width="6"
                                        Height="22"
                                        CornerRadius="3"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ChapterSectionTitle, Mode=OneWay}"
                                        FontSize="18"
                                        FontWeight="SemiBold" />
                                </StackPanel>

                                <Button
                                    HorizontalAlignment="Right"
                                    Padding="10,6"
                                    Click="SortButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8CB;" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.SortButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.CategoryOptions, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChapterCategoryOption">
                                        <ToggleButton
                                            MinHeight="36"
                                            Padding="12,6"
                                            CornerRadius="8"
                                            IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                            Tag="{x:Bind Key}"
                                            Click="CategoryButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon
                                                    Glyph="&#xE73E;"
                                                    FontSize="12"
                                                    Visibility="{x:Bind IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock
                                                    Text="{x:Bind Label}"
                                                    FontWeight="SemiBold" />
                                                <TextBlock
                                                    Text="{x:Bind Count}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Grid>
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedCategoryTitle, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedCategoryCountText, Mode=OneWay}"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.RangeOptions, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChapterRangeOption">
                                        <ToggleButton
                                            MinHeight="30"
                                            Padding="10,4"
                                            CornerRadius="8"
                                            IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                            Tag="{x:Bind Key}"
                                            Click="RangeButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon
                                                    Glyph="&#xE73E;"
                                                    FontSize="10"
                                                    Visibility="{x:Bind IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{x:Bind Label}" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <ItemsRepeater
                                ItemsSource="{x:Bind ViewModel.VisibleChapters, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasChapters, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsJustification="Start"
                                        ItemsStretch="None"
                                        MinColumnSpacing="8"
                                        MinRowSpacing="8"
                                        MinItemWidth="224"
                                        MinItemHeight="38" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:ComicChapter">
                                        <Button
                                            Width="224"
                                            MinHeight="38"
                                            Padding="12,6"
                                            HorizontalContentAlignment="Left"
                                            CornerRadius="8"
                                            Tag="{x:Bind ReaderKey}"
                                            Click="ChapterButton_Click"
                                            ToolTipService.ToolTip="{x:Bind Title}">
                                            <TextBlock
                                                Text="{x:Bind Title}"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
