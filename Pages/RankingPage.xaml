<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="hanabimanga.Pages.RankingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:models="using:hanabimanga.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSource" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:RankToBrushConverter x:Key="RankToBrush" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            x:Name="RankingScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                Width="{Binding ElementName=RankingScrollViewer, Path=ViewportWidth}"
                MinHeight="{Binding ElementName=RankingScrollViewer, Path=ViewportHeight}"
                MaxWidth="1180"
                Padding="32,10,32,32"
                HorizontalAlignment="Center"
                RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel MinWidth="0" Spacing="1">
                        <TextBlock
                            Text="排行榜"
                            FontSize="24"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="按人气与评分排序的漫画榜单"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Padding="12,6"
                        Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </Grid>

                <SelectorBar
                    x:Name="RankingSelector"
                    Grid.Row="1"
                    SelectionChanged="RankingSelector_SelectionChanged">
                    <SelectorBarItem x:Name="DailyItem" Text="日榜" />
                    <SelectorBarItem x:Name="WeeklyItem" Text="周榜" />
                    <SelectorBarItem x:Name="MonthlyItem" Text="月榜" />
                    <SelectorBarItem x:Name="RatingItem" Text="评分" />
                    <SelectorBarItem x:Name="RatingCountItem" Text="人气" />
                </SelectorBar>

                <Grid Grid.Row="2" RowSpacing="4" Margin="0,-6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ProgressRing
                        Grid.Row="0"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <InfoBar
                        Grid.Row="1"
                        IsClosable="False"
                        Severity="Error"
                        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                        Title="榜单加载失败"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                    <Grid
                        Grid.Row="2"
                        MinHeight="360"
                        MinWidth="0"
                        HorizontalAlignment="Stretch">
                        <ItemsRepeater
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsJustification="Start"
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="12"
                                    MinRowSpacing="14"
                                    MinItemWidth="170"
                                    MinItemHeight="320" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:RankingComicItem">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        Padding="10"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="10"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Click="RankingItem_Click"
                                        Tag="{x:Bind Id}"
                                        ToolTipService.ToolTip="{x:Bind Title}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="226" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border
                                                Grid.Row="0"
                                                CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <Image
                                                    Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSource}}"
                                                    Stretch="UniformToFill" />
                                            </Border>

                                            <Border
                                                Grid.Row="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="6"
                                                MinWidth="26"
                                                Height="26"
                                                Padding="8,0"
                                                CornerRadius="6"
                                                Background="{x:Bind Rank, Converter={StaticResource RankToBrush}}">
                                                <TextBlock
                                                    Text="{x:Bind RankText}"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    FontSize="13"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock
                                                Grid.Row="1"
                                                Text="{x:Bind Title}"
                                                FontWeight="SemiBold"
                                                LineHeight="20"
                                                Height="40"
                                                Margin="2,8,2,0"
                                                MaxLines="2"
                                                TextWrapping="Wrap"
                                                TextTrimming="CharacterEllipsis" />

                                            <TextBlock
                                                Grid.Row="2"
                                                Text="{x:Bind Subtitle}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Margin="2,4,2,0"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                Glyph="&#xE8E5;"
                                FontSize="40"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="榜单暂无数据"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
