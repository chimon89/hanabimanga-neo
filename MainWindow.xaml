<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="hanabimanga.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:hanabimanga"
    xmlns:converters="using:hanabimanga.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="花火漫画">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource SakuraMicaOverlayBrush}">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Background="Transparent"
            Loaded="AppTitleBar_Loaded"
            SizeChanged="AppTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="20" />
                <ColumnDefinition Width="2*" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="20" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="PaneToggleButton"
                Grid.Column="1"
                Width="40"
                Height="40"
                Padding="0"
                Margin="4,0,4,0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="PaneToggleButton_Click"
                ToolTipService.ToolTip="导航">
                <FontIcon Glyph="&#xE700;" FontSize="16" />
            </Button>

            <Image
                x:Name="TitleBarLogoImage"
                Grid.Column="2"
                Source="ms-appx:///Assets/logo.png"
                Width="20"
                Height="20"
                Margin="12,0,8,0"
                VerticalAlignment="Center"
                IsHitTestVisible="False" />
            <TextBlock
                x:Name="TitleBarAppNameTextBlock"
                Grid.Column="3"
                Text="花火漫画"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                IsHitTestVisible="False"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                x:Name="DetailTitleBarBreadcrumb"
                Grid.Column="2"
                Grid.ColumnSpan="5"
                Margin="8,0,24,0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <Button
                    x:Name="DetailTitleBarBackButton"
                    Width="34"
                    Height="34"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="DetailTitleBarBackButton_Click"
                    ToolTipService.ToolTip="返回">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button
                    x:Name="DetailTitleBarHomeButton"
                    MinHeight="34"
                    Padding="8,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="DetailTitleBarHomeButton_Click">
                    <TextBlock Text="首页" />
                </Button>
                <FontIcon
                    Glyph="&#xE76C;"
                    FontSize="10"
                    Opacity="0.68"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="DetailTitleBarCategoryTextBlock"
                    Text="漫画"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />
                <FontIcon
                    Glyph="&#xE76C;"
                    FontSize="10"
                    Opacity="0.68"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="DetailTitleBarTitleTextBlock"
                    Text="漫画详情"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    MaxWidth="620"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Grid
                Grid.Column="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,8,0">
                <Button
                    x:Name="NotificationButton"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="通知">
                    <FontIcon Glyph="&#xE7E7;" FontSize="16" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom" Opened="NotificationFlyout_Opened">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MaxWidth" Value="380" />
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <Grid Width="360">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid
                                    Grid.Row="0"
                                    Padding="16,12,8,10"
                                    ColumnSpacing="8"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="通知"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center" />
                                    <Button
                                        x:Name="MarkAllNotificationsReadButton"
                                        Grid.Column="1"
                                        Padding="8,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="MarkAllNotificationsRead_Click">
                                        <TextBlock Text="全部已读" FontSize="12" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <ScrollViewer
                                        x:Name="NotificationScrollViewer"
                                        MaxHeight="460"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsRepeater x:Name="NotificationList">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Vertical" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        CornerRadius="0"
                                                        Padding="16,10"
                                                        Loaded="NotificationItemContainer_Loaded"
                                                        Click="NotificationItem_Click">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse
                                                                Grid.Column="0"
                                                                Width="8"
                                                                Height="8"
                                                                Margin="0,6,0,0"
                                                                VerticalAlignment="Top"
                                                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                                Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />
                                                            <StackPanel Grid.Column="1" Spacing="3">
                                                                <TextBlock
                                                                    Text="{Binding Title}"
                                                                    FontWeight="SemiBold"
                                                                    TextWrapping="Wrap"
                                                                    MaxLines="2"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Text="{Binding Body}"
                                                                    FontSize="12"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    TextWrapping="Wrap"
                                                                    MaxLines="3"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" />
                                                                <TextBlock
                                                                    Text="{Binding TimeText}"
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>

                                    <ProgressRing
                                        x:Name="NotificationLoadingRing"
                                        IsActive="False"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />

                                    <StackPanel
                                        x:Name="NotificationEmptyPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        Visibility="Collapsed">
                                        <FontIcon
                                            Glyph="&#xE7E7;"
                                            FontSize="28"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock
                                            x:Name="NotificationEmptyTextBlock"
                                            Text="暂无通知"
                                            MaxWidth="280"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <InfoBadge
                    x:Name="NotificationBadge"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,3,2,0"
                    IsHitTestVisible="False"
                    Value="0"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <NavigationView
            x:Name="NavigationRoot"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="260"
            CompactPaneLength="48"
            SelectionChanged="NavigationRoot_SelectionChanged"
            DisplayModeChanged="NavigationRoot_DisplayModeChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeNavigationItem"
                    Content="首页"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="漫画" />

                <NavigationViewItem
                    x:Name="DiscoverNavigationItem"
                    Content="发现"
                    Tag="discover">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="CategoryNavigationItem"
                    Content="分类"
                    Tag="category">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="BookshelfNavigationItem"
                    Content="书架"
                    Tag="bookshelf">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="榜单" />

                <NavigationViewItem
                    x:Name="RankingNavigationItem"
                    Content="排行"
                    Tag="ranking">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="系统" />

                <NavigationViewItem
                    x:Name="TaskCenterNavigationItem"
                    Content="任务中心"
                    Tag="task-center">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="AppSettingsNavigationItem"
                    Content="设置"
                    Tag="app-settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
              <StackPanel x:Name="PaneFooterStack">
                <Border
                    x:Name="ContinueReadingBar"
                    Margin="4,0,4,4"
                    Padding="6"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource ContinueReadingBarBackgroundBrush}"
                    PointerEntered="ContinueReadingBar_PointerEntered"
                    PointerExited="ContinueReadingBar_PointerExited"
                    Visibility="Collapsed">
                    <Grid x:Name="ContinueReadingContentGrid" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="ContinueReadingMiddleColumn" Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="ContinueReadingCoverButton"
                            Grid.Column="0"
                            Width="36"
                            Height="44"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="6"
                            Click="ContinueReadingButton_Click"
                            ToolTipService.ToolTip="继续上次阅读">
                            <Border
                                CornerRadius="6"
                                Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                <Image
                                    x:Name="ContinueReadingCoverImage"
                                    Stretch="UniformToFill" />
                            </Border>
                        </Button>

                        <Button
                            x:Name="ContinueReadingTextButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Stretch"
                            Padding="2,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ContinueReadingButton_Click"
                            ToolTipService.ToolTip="继续上次阅读">
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    x:Name="ContinueReadingTitleTextBlock"
                                    Text="继续阅读"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="ContinueReadingSubtitleTextBlock"
                                    Text="上次看到的位置"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="ContinueReadingDismissButton"
                            Grid.Column="2"
                            Width="28"
                            Height="28"
                            Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="DismissContinueReadingBar_Click"
                            ToolTipService.ToolTip="关闭">
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </Grid>
                </Border>

                <Button
                    x:Name="AccountFooterButton"
                    Margin="4,8,4,0"
                    Padding="8,6"
                    MinHeight="52"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    SizeChanged="AccountFooterButton_SizeChanged">
                    <Button.Flyout>
                        <Flyout
                            x:Name="AccountFlyout"
                            Placement="TopEdgeAlignedLeft">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="320" />
                                    <Setter Property="MaxWidth" Value="340" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <Grid
                                Width="320"
                                Padding="8,14"
                                RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <PersonPicture
                                    x:Name="AccountFlyoutPersonPicture"
                                    Width="72"
                                    Height="72"
                                    HorizontalAlignment="Center"
                                    DisplayName="未登录" />

                                <StackPanel
                                    Grid.Row="1"
                                    Spacing="2"
                                    HorizontalAlignment="Center">
                                    <TextBlock
                                        x:Name="AccountFlyoutNameTextBlock"
                                        Text="未登录"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        TextAlignment="Center"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="AccountFlyoutStatusTextBlock"
                                        Text="登录后同步收藏和阅读进度"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextAlignment="Center"
                                        MaxLines="2"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Border
                                    Grid.Row="2"
                                    Height="1"
                                    Margin="0,2,0,0"
                                    Opacity="0.65"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Border
                                    Grid.Row="3"
                                    Padding="6,0,6,0">
                                    <StackPanel Spacing="2">
                                        <StackPanel
                                            x:Name="SignedOutAccountActionsPanel"
                                            Spacing="2">
                                            <Button
                                                MinHeight="40"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Click="SignInMenuButton_Click"
                                                Content="登录" />
                                            <Button
                                                MinHeight="40"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Click="SignUpMenuButton_Click"
                                                Content="注册" />
                                            <Button
                                                MinHeight="40"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Click="MagicLinkMenuButton_Click"
                                                Content="Magic Link 登录" />
                                        </StackPanel>

                                        <StackPanel
                                            x:Name="SignedInAccountActionsPanel"
                                            Spacing="2"
                                            Visibility="Collapsed">
                                            <Button
                                                x:Name="ViewMyProfileButton"
                                                MinHeight="40"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Click="ViewMyProfileButton_Click"
                                                Content="我的主页" />

                                            <Button
                                                x:Name="TaskCenterButton"
                                                MinHeight="40"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Click="TaskCenterButton_Click"
                                                Content="任务中心" />

                                            <Button
                                                x:Name="FeedbackButton"
                                                MinHeight="40"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Click="FeedbackButton_Click"
                                                Content="资源与反馈" />

                                            <Button
                                                x:Name="ViewAccountButton"
                                                MinHeight="40"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Click="ViewAccountButton_Click"
                                                Content="用户设置" />

                                            <Button
                                                x:Name="SignOutMenuButton"
                                                MinHeight="40"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Click="SignOutMenuButton_Click"
                                                Content="退出登录" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>

                    <Grid
                        x:Name="AccountFooterContentGrid"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition x:Name="AccountFooterMiddleColumn" Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <PersonPicture
                            x:Name="AccountPersonPicture"
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            DisplayName="未登录" />

                        <StackPanel
                            x:Name="AccountFooterDetailsPanel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock
                                x:Name="AccountNameTextBlock"
                                Text="登录"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="AccountStatusTextBlock"
                                Text="同步收藏和阅读进度"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <FontIcon
                            x:Name="AccountFooterChevron"
                            Grid.Column="2"
                            Glyph="&#xE70D;"
                            FontSize="10"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
              </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
