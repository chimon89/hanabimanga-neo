<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="hanabimanga.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:hanabimanga"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="花火漫画">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource SakuraMicaOverlayBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Background="Transparent"
            Loaded="AppTitleBar_Loaded"
            SizeChanged="AppTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="20" />
                <ColumnDefinition Width="2*" MinWidth="200" />
                <ColumnDefinition Width="*" MinWidth="20" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="PaneToggleButton"
                Grid.Column="1"
                Width="40"
                Height="40"
                Padding="0"
                Margin="4,0,4,0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="PaneToggleButton_Click"
                ToolTipService.ToolTip="导航">
                <FontIcon Glyph="&#xE700;" FontSize="16" />
            </Button>

            <Image
                x:Name="TitleBarLogoImage"
                Grid.Column="2"
                Source="ms-appx:///Assets/logo.png"
                Width="20"
                Height="20"
                Margin="12,0,8,0"
                VerticalAlignment="Center"
                IsHitTestVisible="False" />
            <TextBlock
                x:Name="TitleBarAppNameTextBlock"
                Grid.Column="3"
                Text="花火漫画"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                IsHitTestVisible="False"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                x:Name="DetailTitleBarBreadcrumb"
                Grid.Column="2"
                Grid.ColumnSpan="5"
                Margin="8,0,24,0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <Button
                    x:Name="DetailTitleBarBackButton"
                    Width="34"
                    Height="34"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="DetailTitleBarBackButton_Click"
                    ToolTipService.ToolTip="返回">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button
                    x:Name="DetailTitleBarHomeButton"
                    MinHeight="34"
                    Padding="8,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="DetailTitleBarHomeButton_Click">
                    <TextBlock Text="首页" />
                </Button>
                <FontIcon
                    Glyph="&#xE76C;"
                    FontSize="10"
                    Opacity="0.68"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="DetailTitleBarCategoryTextBlock"
                    Text="漫画"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />
                <FontIcon
                    Glyph="&#xE76C;"
                    FontSize="10"
                    Opacity="0.68"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="DetailTitleBarTitleTextBlock"
                    Text="漫画详情"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    MaxWidth="620"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <AutoSuggestBox
                x:Name="TitleBarSearchBox"
                Grid.Column="5"
                MinWidth="180"
                MaxWidth="520"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                QueryIcon="Find"
                PlaceholderText="搜索漫画、作者、章节"
                QuerySubmitted="TitleBarSearchBox_QuerySubmitted" />
        </Grid>

        <NavigationView
            x:Name="NavigationRoot"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="260"
            CompactPaneLength="48"
            SelectionChanged="NavigationRoot_SelectionChanged"
            DisplayModeChanged="NavigationRoot_DisplayModeChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeNavigationItem"
                    Content="首页"
                    Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="漫画" />

                <NavigationViewItem
                    x:Name="DiscoverNavigationItem"
                    Content="发现"
                    Tag="discover">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="HistoryNavigationItem"
                    Content="历史"
                    Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="榜单" />

                <NavigationViewItem
                    Content="排行"
                    IsEnabled="False"
                    Tag="ranking">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Button
                    x:Name="AccountFooterButton"
                    Margin="4,8,4,0"
                    Padding="8,6"
                    MinHeight="52"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    SizeChanged="AccountFooterButton_SizeChanged">
                    <Button.Flyout>
                        <Flyout
                            x:Name="AccountFlyout"
                            Placement="TopEdgeAlignedLeft">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="320" />
                                    <Setter Property="MaxWidth" Value="340" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <Grid
                                Width="320"
                                Padding="8,14"
                                RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <PersonPicture
                                        x:Name="AccountFlyoutPersonPicture"
                                        Width="72"
                                        Height="72"
                                        HorizontalAlignment="Center"
                                        DisplayName="未登录" />
                                    <Button
                                        x:Name="AccountSettingsButton"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="账户设置">
                                        <FontIcon Glyph="&#xE713;" FontSize="18" />
                                    </Button>
                                </Grid>

                                <StackPanel
                                    Grid.Row="1"
                                    Spacing="2"
                                    HorizontalAlignment="Center">
                                    <TextBlock
                                        x:Name="AccountFlyoutNameTextBlock"
                                        Text="未登录"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        TextAlignment="Center"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="AccountFlyoutStatusTextBlock"
                                        Text="登录后同步收藏和阅读进度"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextAlignment="Center"
                                        MaxLines="2"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Border
                                    Grid.Row="2"
                                    Height="1"
                                    Margin="0,2,0,0"
                                    Opacity="0.65"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Border
                                    Grid.Row="3"
                                    Padding="6,0,6,0">
                                    <StackPanel Spacing="2">
                                        <Button
                                            x:Name="ViewAccountButton"
                                            MinHeight="40"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="14,8"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="6"
                                            IsEnabled="False"
                                            Content="查看我的账户" />

                                        <StackPanel
                                            x:Name="SignedOutAccountActionsPanel"
                                            Spacing="2">
                                            <Button
                                                MinHeight="40"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Click="SignInMenuButton_Click"
                                                Content="登录" />
                                            <Button
                                                MinHeight="40"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Click="SignUpMenuButton_Click"
                                                Content="注册" />
                                            <Button
                                                MinHeight="40"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Click="MagicLinkMenuButton_Click"
                                                Content="Magic Link 登录" />
                                        </StackPanel>

                                        <StackPanel
                                            x:Name="SignedInAccountActionsPanel"
                                            Spacing="2"
                                            Visibility="Collapsed">
                                            <Button
                                                x:Name="SignOutMenuButton"
                                                MinHeight="40"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="14,8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="6"
                                                Click="SignOutMenuButton_Click"
                                                Content="退出登录" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>

                    <Grid
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <PersonPicture
                            x:Name="AccountPersonPicture"
                            Width="36"
                            Height="36"
                            VerticalAlignment="Center"
                            DisplayName="未登录" />

                        <StackPanel
                            x:Name="AccountFooterDetailsPanel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock
                                x:Name="AccountNameTextBlock"
                                Text="登录"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="AccountStatusTextBlock"
                                Text="同步收藏和阅读进度"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <FontIcon
                            Grid.Column="2"
                            Glyph="&#xE70D;"
                            FontSize="10"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Button>
            </NavigationView.PaneFooter>

            <Frame x:Name="RootFrame" />
        </NavigationView>

        <Border
            x:Name="ContinueReadingBar"
            Grid.Row="1"
            Grid.Column="0"
            Width="520"
            MaxWidth="620"
            MinHeight="76"
            Margin="0,0,56,28"
            Padding="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource ContinueReadingBarBackgroundBrush}"
            PointerEntered="ContinueReadingBar_PointerEntered"
            PointerExited="ContinueReadingBar_PointerExited"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Padding="10,6"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ContinueReadingButton_Click"
                    ToolTipService.ToolTip="继续上次阅读">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="48"
                            Height="56"
                            CornerRadius="8"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}">
                            <Image
                                x:Name="ContinueReadingCoverImage"
                                Stretch="UniformToFill" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="1">
                            <TextBlock
                                x:Name="ContinueReadingTitleTextBlock"
                                Text="继续阅读"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="ContinueReadingSubtitleTextBlock"
                                Text="上次看到的位置"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            x:Name="ContinueReadingProgressTextBlock"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="继续" />
                    </Grid>
                </Button>

                <Button
                    Grid.Column="1"
                    Width="36"
                    Height="36"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="DismissContinueReadingBar_Click"
                    ToolTipService.ToolTip="关闭">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
